# Telegram user API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/job_hunter_user
# Optional for non-interactive runners; keep empty locally until exported securely.
TELEGRAM_SESSION_STRING=
STATE_REPO=
STATE_REPO_TOKEN=

# Bot notification credentials from @BotFather. Never commit this file.
BOT_TOKEN=
NOTIFICATION_CHAT_ID=
BOT_SESSION_PATH=data/job_hunter_bot

DATABASE_PATH=data/kan_job_hunter.sqlite3
LOG_DIR=logs
POLL_INTERVAL_SECONDS=300
DISCOVERY_INTERVAL_SECONDS=3600
DISCOVERY_LIMIT_PER_QUERY=20
RECENT_MESSAGES_PER_SOURCE=30
LOG_LEVEL=INFO
